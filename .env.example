# Agentic Engineering Interview Platform environment template
# Copy to .env.local for local app development or map these values into your
# deployment secret store. Do not commit real secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME="YeetCode"
APP_ENV="development"
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3000"

# Used for invite tokens, session tokens, webhook signatures, and encrypted app
# payloads. Generate long random values for real environments.
APP_SECRET=""
INVITE_TOKEN_SECRET=""
WEBHOOK_SIGNING_SECRET=""
ENCRYPTION_KEY=""

# Comma-separated origins allowed to call the API.
ALLOWED_ORIGINS="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase Auth, Postgres, Storage, Realtime
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_DB_URL=""

# Storage buckets to create/use.
SUPABASE_BUCKET_PROBLEM_ASSETS="problem-assets"
SUPABASE_BUCKET_TEST_CASES="test-cases"
SUPABASE_BUCKET_SESSION_ARTIFACTS="session-artifacts"
SUPABASE_BUCKET_RECORDINGS="recordings"

# Optional local Supabase config.
SUPABASE_PROJECT_REF=""
SUPABASE_ACCESS_TOKEN=""

# -----------------------------------------------------------------------------
# Gemini / Google AI
# -----------------------------------------------------------------------------
# Use exactly one auth path for MVP: Gemini Developer API key or Vertex AI.
GEMINI_API_KEY=""

# Keep model IDs configurable. Update these to the exact Gemini 3.5 model you
# have access to.
GEMINI_JUDGE_MODEL="gemini-3.5-flash"
GEMINI_CASE_MODEL="gemini-3.5-flash"
GEMINI_FEEDBACK_MODEL="gemini-3.5-flash"

# Judge settings.
GEMINI_JUDGE_TRIES="3"
GEMINI_JUDGE_TEMPERATURE="0.2"
GEMINI_JUDGE_THINKING_LEVEL="medium"

# -----------------------------------------------------------------------------
# Google Antigravity
# -----------------------------------------------------------------------------
# Exact installation/auth details needed for building the Azure VM image.
ANTIGRAVITY_CLI_INSTALL_URL=""
ANTIGRAVITY_IDE_INSTALL_URL=""
ANTIGRAVITY_VERSION=""
ANTIGRAVITY_LICENSE_KEY=""
ANTIGRAVITY_AUTH_MODE="managed" # managed | candidate_bring_your_own | device_code
ANTIGRAVITY_ORG_ID=""
ANTIGRAVITY_API_KEY=""
ANTIGRAVITY_CONFIG_TEMPLATE_PATH=""

# Paths expected inside the VM.
ANTIGRAVITY_CLI_PATH="/usr/local/bin/antigravity"
ANTIGRAVITY_IDE_PATH="/opt/antigravity/antigravity"
ANTIGRAVITY_WORKSPACE_ROOT="/workspace"

# -----------------------------------------------------------------------------
# Google Cloud Platform (GCP) Core
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=""
GCP_REGION="us-central1"
GCP_ZONE="us-central1-a"
GOOGLE_APPLICATION_CREDENTIALS=""

# Google Cloud Secret Manager keys
GCP_SECRET_NAME_SUPABASE_KEY="supabase-service-key"
GCP_SECRET_NAME_GEMINI_KEY="gemini-api-key"

# Container deployment, if using Cloud Run.
GCP_CLOUD_RUN_SERVICE_NAME="yeetcode-api"
GCP_ARTIFACT_REGISTRY_REPO="yeetcode-docker-repo"

# Optional Cloud Pub/Sub topics for workers and VM hooks.
GCP_PUBSUB_TOPIC_EVALUATIONS="evaluation-jobs"
GCP_PUBSUB_TOPIC_VM_EVENTS="vm-events"

# -----------------------------------------------------------------------------
# GCP Compute Engine VM Pool / Remote Linux Desktop
# -----------------------------------------------------------------------------
GCP_GCE_ZONE="us-central1-a"
GCP_GCE_MACHINE_TYPE="n2-standard-4"
GCP_GCE_ADMIN_USERNAME="interview"
GCP_GCE_ADMIN_SSH_PUBLIC_KEY=""
GCP_GCE_ADMIN_SSH_PRIVATE_KEY_PATH=""

# Golden image details.
GCP_GCE_IMAGE_PROJECT=""
GCP_GCE_IMAGE_FAMILY=""
GCP_GCE_IMAGE_NAME=""
GCP_GCE_OS_DISK_SIZE_GB="128"

# Network isolation.
GCP_VPC_NETWORK="yeetcode-vpc"
GCP_SUBNET="yeetcode-subnet"
GCP_FIREWALL_RULE_ISOLATED="block-external-egress"
GCP_PUBLIC_IP_ENABLED="false"

# VM pool sizing.
VM_POOL_MIN_WARM="0"
VM_POOL_MAX_ACTIVE="10"
VM_SESSION_TTL_MINUTES="120"
VM_IDLE_TIMEOUT_MINUTES="20"
VM_CLEANUP_MODE="destroy" # destroy | reset_snapshot | keep_for_debug

# Harness agent running inside each VM.
VM_HARNESS_AGENT_PORT="8787"
VM_HARNESS_AGENT_TOKEN=""
VM_BOOTSTRAP_SCRIPT_URL=""

# -----------------------------------------------------------------------------
# Remote Desktop Gateway
# -----------------------------------------------------------------------------
# Choose one for MVP: novnc or guacamole.
REMOTE_DESKTOP_PROVIDER="novnc" # novnc | guacamole
REMOTE_DESKTOP_PUBLIC_BASE_URL=""
REMOTE_DESKTOP_TOKEN_SECRET=""
REMOTE_DESKTOP_SESSION_TTL_SECONDS="7200"

# noVNC / websockify settings.
NOVNC_BASE_URL=""
NOVNC_WEBSOCKET_BASE_URL=""
NOVNC_PROXY_HOST=""
NOVNC_PROXY_PORT="6080"
NOVNC_VNC_HOST="127.0.0.1"
NOVNC_VNC_PORT="5901"
NOVNC_PASSWORD=""

# Apache Guacamole settings (optional if using noVNC).
GUACAMOLE_BASE_URL=""
GUACAMOLE_API_URL=""
GUACAMOLE_ADMIN_USERNAME=""
GUACAMOLE_ADMIN_PASSWORD=""
GUACAMOLE_DATABASE_URL=""
GUACAMOLE_JWT_SECRET=""

# GCP Identity-Aware Proxy (IAP) can be used as an admin/debug fallback.
GCP_IAP_TUNNEL_TARGET_PORT="22"

# -----------------------------------------------------------------------------
# Video Calling
# -----------------------------------------------------------------------------
# Choose one: livekit | none
VIDEO_PROVIDER="livekit"

# LiveKit (Mocked interface visual panels, ready for future WebRTC wire-up)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL=""

# Recording, optional for MVP.
VIDEO_RECORDING_ENABLED="false"
VIDEO_RECORDING_BUCKET="recordings"
VIDEO_RECORDING_RETENTION_DAYS="30"

# -----------------------------------------------------------------------------
# Realtime Events
# -----------------------------------------------------------------------------
# Supabase Realtime is the default.
REALTIME_PROVIDER="supabase"

# -----------------------------------------------------------------------------
# Evaluation Harness
# -----------------------------------------------------------------------------
EVALUATION_WORKER_CONCURRENCY="2"
EVALUATION_JOB_TIMEOUT_SECONDS="1800"
EVALUATION_SANDBOX_PROVIDER="vm" # vm | container
EVALUATION_RUN_HIDDEN_TESTS_IN="worker" # worker | candidate_vm

# Test execution limits.
TEST_CASE_MAX_FILE_MB="50"
TEST_CASE_MAX_ARCHIVE_MB="500"
TEST_CASE_TIMEOUT_SECONDS="300"
TEST_CASE_ALLOW_ARBITRARY_CODE="false"

# Cost and rate controls.
MAX_PRACTICE_SESSIONS_PER_USER_PER_DAY="5"
MAX_JUDGE_CALLS_PER_SESSION="3"
MAX_GEMINI_COST_USD_PER_SESSION=""
MAX_VM_COST_USD_PER_SESSION=""

# -----------------------------------------------------------------------------
# Problem Defaults
# -----------------------------------------------------------------------------
DEFAULT_PROBLEM_LANGUAGE="python"
DEFAULT_AGENTIC_VM_IMAGE="ubuntu-antigravity-python3-v1"
DEFAULT_SKILL_VM_IMAGE="ubuntu-antigravity-python3-v1"
DEFAULT_PROMPT_VM_IMAGE="ubuntu-antigravity-python3-v1"
DEFAULT_SESSION_DURATION_MINUTES="60"

# -----------------------------------------------------------------------------
# Email / Invites
# -----------------------------------------------------------------------------
# Use Supabase email for auth by default. Add SMTP or transactional email details
# if the app sends custom candidate invites.
EMAIL_PROVIDER="supabase" # supabase | resend | sendgrid | smtp
EMAIL_FROM="interviews@example.com"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USERNAME=""
SMTP_PASSWORD=""

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL="info"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# -----------------------------------------------------------------------------
# Compliance / Retention
# -----------------------------------------------------------------------------
RECORDING_CONSENT_REQUIRED="true"
SESSION_ARTIFACT_RETENTION_DAYS="90"
SCREEN_RECORDING_RETENTION_DAYS="30"
CODE_SNAPSHOT_RETENTION_DAYS="90"
TRANSCRIPT_RETENTION_DAYS="90"

# Optional free-form notes for setup decisions that are not secrets.
PLATFORM_OWNER_EMAIL=""
PRIMARY_GCP_CONTACT=""
