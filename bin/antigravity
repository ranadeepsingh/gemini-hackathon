            "python-backend-io-service": """import json


def _is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def calculate_score(payload):
    inputs = payload.get("inputs")
    weights = payload.get("weights")

    if not isinstance(inputs, list) or not isinstance(weights, list):
        raise ValueError("inputs and weights must be lists")
    if not inputs or len(inputs) != len(weights):
        raise ValueError("inputs and weights must be non-empty arrays of equal length")
    if not all(_is_number(item) for item in inputs + weights):
        raise ValueError("inputs and weights must contain only numeric values")

    total_weight = sum(weights)
    if total_weight <= 0:
        raise ValueError("weights must have a positive total")

    return round(sum(value * weight for value, weight in zip(inputs, weights)) / total_weight, 3)


def handle_request(method, path, body):
    if path != "/score":
        return 404, {"error": "route_not_found"}
    if method != "POST":
        return 405, {"error": "method_not_allowed"}

    try:
        payload = json.loads(body or "{}")
        score = calculate_score(payload)
        threshold = payload.get("threshold", 0.75)
        if not _is_number(threshold):
            raise ValueError("threshold must be numeric")
    except (json.JSONDecodeError, ValueError) as exc:
        return 400, {"error": str(exc)}

    return 200, {
        "score": score,
        "passed": score >= threshold,
    }
