        print(f"{yellow}[antigravity agent] [RECOVERY] Gemini API was unreachable or timed out: {str(e)}{nc}")
        print(f"{violet}[antigravity agent] [THINKING] Switching to localized cognitive backup heuristics for '{problem_slug}'...{nc}")
        time.sleep(1)

        # Precompiled solution heuristics mapping
