            "prompt-data-leak-shield": """import re

def sanitize_pii(text):
    text = re.sub(r'\\b\\d{3}-\\d{2}-\\d{4}\\b', '[REDACTED_SSN]', text)
    text = re.sub(r'\\b\\d{3}-\\d{3}-\\d{4}\\b', '[REDACTED_PHONE]', text)
