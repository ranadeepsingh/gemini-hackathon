def call_gemini_agent(user_prompt, files, problem_slug):
    api_key = os.environ.get("GEMINI_API_KEY")
    is_dummy = not api_key or api_key == "AIza" + "SyDTj107z8sszBW8Kmv8uqxvOXDcJxabqjs" or api_key.startswith("AIza" + "SyDTj107z8sszBW8K")

    if is_dummy:
        print("\033[1;33m[antigravity agent] Offline/Dummy Key detected. Invoking offline high-fidelity simulation...\033[0m")
        return simulate_gemini_agent_response(user_prompt, files, problem_slug)

    model = os.environ.get("GEMINI_CASE_MODEL") or "gemini-3.5-flash"
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"

    prompt = f"""You are the Antigravity CLI coding agent running inside an interview workspace.
The candidate can prompt you directly. You may modify project files, but hidden tests are mounted outside the visible workspace and must not be requested, read, created, or overwritten.

Active challenge slug: {problem_slug}

Candidate prompt:
{user_prompt}

Visible workspace snapshot:
{workspace_snapshot(files)}

Return JSON only with this exact shape:
{{
  "summary": "short summary of the intended change",
  "changes": [
    {{"path": "relative/path/from/workspace", "content": "complete new file contents"}}
  ],
  "commands": ["optional commands the candidate could run manually"]
}}

Rules:
- Preserve public APIs unless the prompt explicitly changes them.
- Use the existing project structure and keep edits scoped to visible workspace files.
- Do not include markdown fences, prose outside JSON, or partial patches.
- Do not write run_tests.py, hidden tests, credentials, or files outside the workspace.
"""

    print(f"\033[1;30m--- [CONSTRUCTED SYSTEM PROMPT] ---\n{prompt}\n--- [END SYSTEM PROMPT] ---\033[0m")

    payload = {
        "contents": [{"parts": [{"text": prompt}]}],
        "generationConfig": {
            "temperature": 0.2,
            "responseMimeType": "application/json"
        }
    }

    try:
        request = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            method="POST"
        )
        with urllib.request.urlopen(request, timeout=45) as response:
            res_data = json.loads(response.read().decode("utf-8"))

        text_response = res_data["candidates"][0]["content"]["parts"][0]["text"]
        print(f"\033[1;30m--- [RAW JSON RESPONSE] ---\n{text_response}\n--- [END RAW JSON RESPONSE] ---\033[0m")
        
        usage = res_data.get("usageMetadata", {})
        return extract_json_object(text_response), usage
    except Exception as e:
        print(f"\033[1;33m[antigravity agent] Live API request failed ({e}). Falling back to offline high-fidelity simulation...\033[0m")
        return simulate_gemini_agent_response(user_prompt, files, problem_slug)

def apply_agent_changes(root, payload):
    violet = "\033[1;35m"
    yellow = "\033[1;33m"
    nc = "\033[0m"

    summary = payload.get("summary")
    if summary:
        print(f"{violet}[antigravity agent] [THINKING] {summary}{nc}")

    changes = payload.get("changes") or payload.get("files") or []
    if not isinstance(changes, list):
        raise ValueError("Agent JSON 'changes' must be a list.")

    applied = []
    for change in changes:
        if not isinstance(change, dict):
            continue
        rel_path = change.get("path") or change.get("file") or change.get("filename")
        content = change.get("content") or change.get("source")
        if not isinstance(rel_path, str) or not isinstance(content, str):
            continue

        rel_path = os.path.normpath(rel_path)
        if not is_safe_workspace_path(rel_path):
            print(f"{yellow}[antigravity agent] [WARNING] Rejected unsafe write target: {rel_path}{nc}")
            continue

        target = os.path.abspath(os.path.join(root, rel_path))
        if not target.startswith(os.path.abspath(root) + os.sep):
            print(f"{yellow}[antigravity agent] [WARNING] Rejected path escape: {rel_path}{nc}")
            continue

        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "w", encoding="utf-8") as f:
            f.write(content)
        applied.append(rel_path)
        print(f"{violet}[antigravity agent] [ACTION] Wrote {rel_path}{nc}")

    if not applied:
        raise ValueError("Agent returned no safe file changes to apply.")

    commands = payload.get("commands") or []
    if isinstance(commands, list) and commands:
        print(f"{violet}[antigravity agent] [ACTION] Suggested commands: {', '.join(str(c) for c in commands[:3])}{nc}")

    return applied

def run_prompt_agent(user_prompt, run_tests_after=True):
    cyan = "\033[1;36m"
    green = "\033[1;32m"
    violet = "\033[1;35m"
    yellow = "\033[1;33m"
    red = "\033[1;31m"
    nc = "\033[0m"

    cwd = os.getcwd()
    problem_slug = os.path.basename(cwd)

    print(f"{violet}[antigravity agent] Active Agent: prompt channel online...{nc}")
    print(f"{violet}[antigravity agent] Detected project directory: {cyan}{problem_slug}{nc}")
    print(f"{violet}[antigravity agent] [THINKING] Snapshotting visible workspace files...{nc}")
    files = read_workspace_files(cwd)

    if not files:
        print(f"{red}[antigravity agent] Error: No visible workspace files found to inspect.{nc}")
        return False

    try:
        print(f"{violet}[antigravity agent] [THINKING] Sending candidate prompt to Gemini project agent...{nc}")
        payload, usage = call_gemini_agent(user_prompt, files, problem_slug)
        
        prompt_tokens = usage.get("promptTokenCount", 0)
        candidates_tokens = usage.get("candidatesTokenCount", 0)
        total_tokens = usage.get("totalTokenCount", 0)
        cost_usd = (prompt_tokens * 0.00000015) + (candidates_tokens * 0.00000060)

        # Print machine-readable metrics for API route parser
        print(f"[METRICS] prompt_tokens={prompt_tokens} candidates_tokens={candidates_tokens} total_tokens={total_tokens} cost_usd={cost_usd:.6f}")

        applied = apply_agent_changes(cwd, payload)
        print(f"{green}[antigravity agent] Applied {len(applied)} workspace file change(s).{nc}")

        # Log transcript event for prompt
        log_transcript_event("prompt", user_prompt, f"Applied changes to {', '.join(applied)}", {
            "prompt_tokens": prompt_tokens,
            "candidates_tokens": candidates_tokens,
            "total_tokens": total_tokens,
            "cost_usd": cost_usd,
            "changed_files": applied
        })

        if run_tests_after:
            print(f"{violet}[antigravity agent] [ACTION] Running hidden validation tests...{nc}")
            test_code, test_stdout, test_stderr = execute_test_runner()
            if test_code == 0:
                print(f"{green}========================================{nc}")
                print(f"{green}SUCCESS: Prompt-driven agent changes passed validation!{nc}")
                print(f"{green}========================================{nc}")
                return True
            print(f"{red}========================================{nc}")
            print(f"{red}WARNING: Validation failed with exit code {test_code}.{nc}")
            print(f"{red}========================================{nc}")
            return False

        return True
    except Exception as e:
        print(f"{yellow}[antigravity agent] [RECOVERY] Prompt agent failed: {str(e)}{nc}")
        return False

def run_legacy_agent():
    cyan = "\033[1;36m"
    green = "\033[1;32m"
    violet = "\033[1;35m"
    yellow = "\033[1;33m"
