#!/usr/bin/env python3
import sys
import os
import json
import urllib.request
import subprocess
import time
import re

SKIP_DIRS = {"__pycache__", ".git", ".hg", ".svn", ".next", "node_modules", ".antigravity", ".antigravitycli"}
SKIP_FILES = {"run_tests.py", ".DS_Store"}
MAX_SNAPSHOT_FILE_BYTES = 180_000

def print_help():
    cyan = "\033[1;36m"
    green = "\033[1;32m"
    violet = "\033[1;35m"
    yellow = "\033[1;33m"
    red = "\033[1;31m"
    nc = "\033[0m"

    print(f"""{cyan}🌌 Google Antigravity (AGY) Autonomous CLI v2.0{nc}
======================================================
{green}Usage:{nc}
  antigravity [command] [prompt]

{green}Available Commands:{nc}
  {cyan}help{nc}                  - Display this instruction index.
  {cyan}status{nc}                - Audit active workspace metrics and CLI state.
  {cyan}test{nc}                  - Execute the hidden candidate validation suite.
  {cyan}run [prompt]{nc}          - Deploy the agent against the current project directory.
  {cyan}prompt "instruction"{nc}  - Send a direct prompt to the agent and apply its edits.
  {cyan}ask "instruction"{nc}     - Alias for prompt.

{green}Examples:{nc}
  antigravity prompt "Implement POST /score and validate bad JSON inputs"
  antigravity run "Refactor app.py without changing the public API"
  antigravity test

{yellow}Environmental Variables:{nc}
  GEMINI_API_KEY      : {"[CONFIGURED]" if os.environ.get("GEMINI_API_KEY") else "[MISSING]"}
  GEMINI_CASE_MODEL   : {os.environ.get("GEMINI_CASE_MODEL", "gemini-3.5-flash")}
  AGY_TEST_RUNNER     : {"[CONFIGURED]" if os.environ.get("AGY_TEST_RUNNER") else "[LOCAL FALLBACK]"}
""")

def print_status():
    cyan = "\033[1;36m"
    green = "\033[1;32m"
    nc = "\033[0m"

    cwd = os.getcwd()
    problem_slug = os.path.basename(cwd)

    print(f"""{cyan}[antigravity status] Secure VM Sandbox Integrity Report{nc}
------------------------------------------------------
Container Node ID  : anticode-gce-node-us-central-4a
Terminal Port      : 8787 (TLS Active)
Operating System   : Ubuntu 22.04 LTS (Security Hardened)
Active Problem     : {green}{problem_slug}{nc}
Sandbox Directory  : {cwd}
Antigravity Core   : Active and pre-authorized
Hidden Tests       : {"Mounted" if os.environ.get("AGY_TEST_RUNNER") else "Local fallback"}
""")

def execute_test_runner():
    green = "\033[1;32m"
    red = "\033[1;31m"
    nc = "\033[0m"

    hidden_runner = os.environ.get("AGY_TEST_RUNNER")
    if hidden_runner and os.path.exists(hidden_runner):
        test_cmd = [sys.executable, hidden_runner]
        print(f"{green}[antigravity test] Executing hidden candidate validation suite...{nc}")
    elif os.path.exists("run_tests.py"):
        test_cmd = [sys.executable, "run_tests.py"]
        print(f"{green}[antigravity test] Executing localized candidate unit test suite...{nc}")
    else:
        print(f"{red}[antigravity test] Error: run_tests.py not found in this directory.{nc}")
        return 1

    env = os.environ.copy()
    workspace_path = os.getcwd()
    env["PYTHONPATH"] = workspace_path + os.pathsep + env.get("PYTHONPATH", "")
    res = subprocess.run(test_cmd, capture_output=True, text=True, cwd=workspace_path, env=env)
    print(res.stdout)
    print(res.stderr)
    return res.returncode

def run_tests():
    sys.exit(execute_test_runner())

def is_safe_workspace_path(relative_path):
    if not relative_path or os.path.isabs(relative_path):
        return False
    normalized = os.path.normpath(relative_path)
    if normalized.startswith("..") or normalized == ".":
        return False
    parts = set(normalized.split(os.sep))
    if parts & SKIP_DIRS:
        return False
    if os.path.basename(normalized) in SKIP_FILES:
        return False
    return True

def read_workspace_files(root):
    files = {}
    for current_root, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        for name in names:
            if name in SKIP_FILES:
                continue
            full_path = os.path.join(current_root, name)
            rel_path = os.path.relpath(full_path, root)
            if not is_safe_workspace_path(rel_path):
                continue
            try:
                size = os.path.getsize(full_path)
                if size > MAX_SNAPSHOT_FILE_BYTES:
                    files[rel_path] = f"[omitted: file is {size} bytes]"
                    continue
                with open(full_path, "r", encoding="utf-8") as f:
                    files[rel_path] = f.read()
            except UnicodeDecodeError:
                files[rel_path] = "[omitted: binary or non-utf8 file]"
            except OSError:
                continue
    return dict(sorted(files.items()))

def workspace_snapshot(files):
    blocks = []
    for file_path, content in files.items():
        blocks.append(f"--- FILE: {file_path} ---\n{content}")
    return "\n\n".join(blocks)

def extract_json_object(text):
    cleaned = text.strip()
    fenced = re.search(r"```(?:json)?\s*(.*?)```", cleaned, re.DOTALL | re.IGNORECASE)
    if fenced:
        cleaned = fenced.group(1).strip()

    try:
        return json.loads(cleaned)
    except json.JSONDecodeError:
        pass

    start = cleaned.find("{")
    end = cleaned.rfind("}")
    if start >= 0 and end > start:
        return json.loads(cleaned[start:end + 1])

    raise ValueError("Agent response did not contain a valid JSON object.")

def call_gemini_agent(user_prompt, files, problem_slug):
    api_key = os.environ.get("GEMINI_API_KEY")
    if not api_key:
        raise RuntimeError("GEMINI_API_KEY environment variable is not defined.")

    model = os.environ.get("GEMINI_CASE_MODEL") or "gemini-3.5-flash"
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"

    prompt = f"""You are the Antigravity CLI coding agent running inside an interview workspace.
The candidate can prompt you directly. You may modify project files, but hidden tests are mounted outside the visible workspace and must not be requested, read, created, or overwritten.

Active challenge slug: {problem_slug}

Candidate prompt:
{user_prompt}

Visible workspace snapshot:
{workspace_snapshot(files)}

Return JSON only with this exact shape:
{{
  "summary": "short summary of the intended change",
  "changes": [
    {{"path": "relative/path/from/workspace", "content": "complete new file contents"}}
  ],
  "commands": ["optional commands the candidate could run manually"]
}}

Rules:
- Preserve public APIs unless the prompt explicitly changes them.
- Use the existing project structure and keep edits scoped to visible workspace files.
- Do not include markdown fences, prose outside JSON, or partial patches.
- Do not write run_tests.py, hidden tests, credentials, or files outside the workspace.
"""

    payload = {
        "contents": [{"parts": [{"text": prompt}]}],
        "generationConfig": {
            "temperature": 0.2,
            "responseMimeType": "application/json"
        }
    }

    request = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST"
    )
    with urllib.request.urlopen(request, timeout=45) as response:
        res_data = json.loads(response.read().decode("utf-8"))

    text_response = res_data["candidates"][0]["content"]["parts"][0]["text"]
    return extract_json_object(text_response)

def apply_agent_changes(root, payload):
    violet = "\033[1;35m"
    yellow = "\033[1;33m"
    nc = "\033[0m"

    summary = payload.get("summary")
    if summary:
        print(f"{violet}[antigravity agent] [THINKING] {summary}{nc}")

    changes = payload.get("changes") or payload.get("files") or []
    if not isinstance(changes, list):
        raise ValueError("Agent JSON 'changes' must be a list.")

    applied = []
    for change in changes:
        if not isinstance(change, dict):
            continue
        rel_path = change.get("path") or change.get("file") or change.get("filename")
        content = change.get("content") or change.get("source")
        if not isinstance(rel_path, str) or not isinstance(content, str):
            continue

        rel_path = os.path.normpath(rel_path)
        if not is_safe_workspace_path(rel_path):
            print(f"{yellow}[antigravity agent] [WARNING] Rejected unsafe write target: {rel_path}{nc}")
            continue

        target = os.path.abspath(os.path.join(root, rel_path))
        if not target.startswith(os.path.abspath(root) + os.sep):
            print(f"{yellow}[antigravity agent] [WARNING] Rejected path escape: {rel_path}{nc}")
            continue

        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "w", encoding="utf-8") as f:
            f.write(content)
        applied.append(rel_path)
        print(f"{violet}[antigravity agent] [ACTION] Wrote {rel_path}{nc}")

    if not applied:
        raise ValueError("Agent returned no safe file changes to apply.")

    commands = payload.get("commands") or []
    if isinstance(commands, list) and commands:
        print(f"{violet}[antigravity agent] [ACTION] Suggested commands: {', '.join(str(c) for c in commands[:3])}{nc}")

    return applied

def run_prompt_agent(user_prompt, run_tests_after=True):
    cyan = "\033[1;36m"
    green = "\033[1;32m"
    violet = "\033[1;35m"
    yellow = "\033[1;33m"
    red = "\033[1;31m"
    nc = "\033[0m"

    cwd = os.getcwd()
    problem_slug = os.path.basename(cwd)

    print(f"{violet}[antigravity agent] Active Agent: prompt channel online...{nc}")
    print(f"{violet}[antigravity agent] Detected project directory: {cyan}{problem_slug}{nc}")
    print(f"{violet}[antigravity agent] [THINKING] Snapshotting visible workspace files...{nc}")
    files = read_workspace_files(cwd)

    if not files:
        print(f"{red}[antigravity agent] Error: No visible workspace files found to inspect.{nc}")
        return False

    try:
        print(f"{violet}[antigravity agent] [THINKING] Sending candidate prompt to Gemini project agent...{nc}")
        payload = call_gemini_agent(user_prompt, files, problem_slug)
        applied = apply_agent_changes(cwd, payload)
        print(f"{green}[antigravity agent] Applied {len(applied)} workspace file change(s).{nc}")

        if run_tests_after:
            print(f"{violet}[antigravity agent] [ACTION] Running hidden validation tests...{nc}")
            test_code = execute_test_runner()
            if test_code == 0:
                print(f"{green}========================================{nc}")
                print(f"{green}SUCCESS: Prompt-driven agent changes passed validation!{nc}")
                print(f"{green}========================================{nc}")
                return True
            print(f"{red}========================================{nc}")
            print(f"{red}WARNING: Validation failed with exit code {test_code}.{nc}")
            print(f"{red}========================================{nc}")
            return False

        return True
    except Exception as e:
        print(f"{yellow}[antigravity agent] [RECOVERY] Prompt agent failed: {str(e)}{nc}")
        return False

