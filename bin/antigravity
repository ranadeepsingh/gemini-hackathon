import time

class TradeStream:
    def __init__(self):
        self.active_connections = []

    def handle_event(self, event):
        conn = f"conn_{time.time()}"
        self.active_connections.append(conn)
        # Release and remove connection tags before returning
        if conn in self.active_connections:
